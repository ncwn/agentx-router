#!/usr/bin/env bash
# agentx-up — start the router daemon on the fixed port (foreground).
# Loads .env, seeds var/active-mode if missing, then runs router.js.
# Leave this running (a terminal tab, tmux pane, or background it). Switch
# modes any time with ./agentx-mode <MODE> — no restart needed.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$HERE/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$HERE/.env"
  set +a
fi

STATE_FILE="${AGENTX_STATE_FILE:-$HERE/var/active-mode}"
mkdir -p "$(dirname "$STATE_FILE")"

if [ ! -f "$STATE_FILE" ]; then
  printf '%s\n' "$(printf '%s' "${AGENTX_MODE:-NATIVE}" | tr '[:lower:]' '[:upper:]')" > "$STATE_FILE"
fi

exec node "$HERE/router.js"
