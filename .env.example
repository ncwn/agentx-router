# Copy to .env and set the server group URL and key for each upstream you use.
# Base URLs are host roots without a /v1 suffix. The server decides which
# concrete model each group uses.

AGENTX_NATIVE_BASE=http://your-server:8090
AGENTX_NATIVE_KEY=

AGENTX_PERFORMANCE_BASE=http://your-server:8090
AGENTX_PERFORMANCE_KEY=

AGENTX_BALANCE_BASE=http://your-server:8090
AGENTX_BALANCE_KEY=

# Optional local settings.
# AGENTX_PORT=8787
# AGENTX_MODE=NATIVE
# AGENTX_STATE_FILE=/path/to/active-mode
# AGENTX_CONNECT_TIMEOUT_MS=60000
# AGENTX_IDLE_TIMEOUT_MS=300000
