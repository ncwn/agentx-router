# agentx-cc-router upstreams — copy to .env and fill in. (.env is gitignored.)
# Keep comments on their OWN lines (never inline after a value).
#
# Each upstream = a Sub2API base URL (host root, NO /v1 suffix) + its group key.
# The router sends the Bearer token; Sub2API reads it to select the group.
#
# Topology: native + two GPT groups, each doing per-tier mapping on its dashboard.
#   native = Anthropic group  (real Claude passthrough; serves claude-opus / claude-sonnet / claude-haiku)
#   gpt55  = PERFORMANCE group: opus->gpt-5.5, sonnet->gpt-5.5, haiku->gpt-5.4
#            (the router only ever sends opus/sonnet here, so in practice -> gpt-5.5)
#   gpt54  = BALANCE group: opus/sonnet/haiku ALL -> gpt-5.4

# The three bases below are distinct only to illustrate that each upstream is a
# separate Sub2API GROUP. They MAY all point at the same host — the router
# distinguishes groups by the Bearer KEY it sends, not by the URL. Set each to
# your real Sub2API host root (no /v1 suffix) and its group key.

# --- native (real Claude) — NPU/NP/NB (opus+sonnet+background) and the Opus advisor in HP/HB ---
AGENTX_NATIVE_BASE=http://your-sub2api-host:8090
AGENTX_NATIVE_KEY=

# --- gpt55 = PERFORMANCE group (opus/sonnet->5.5, haiku->5.4) — HP(sonnet), BPU/BP(opus+sonnet), BBU(opus), BB(opus advisor) ---
AGENTX_GPT55_BASE=http://your-sub2api-host:8090
AGENTX_GPT55_KEY=

# --- gpt54 = BALANCE group (all->5.4) — HB(sonnet), BB/BBU(sonnet), and background/haiku in HP/HB + the 4 backup modes ---
AGENTX_GPT54_BASE=http://your-sub2api-host:8090
AGENTX_GPT54_KEY=

# --- optional: the single fixed port the router listens on (must match settings.json) ---
# AGENTX_PORT=8787
# --- optional: bump for high reasoning effort if you see spurious 502s on connect ---
# AGENTX_CONNECT_TIMEOUT_MS=180000
# --- optional: idle deadline once a response is streaming (default 300000 = 5 min) ---
# raise it for long high/xhigh runs whose stream stays quiet during reasoning
# AGENTX_IDLE_TIMEOUT_MS=900000
