#!/usr/bin/env bash
# Manage agentx-cc-router as a user-level service.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/service/common.sh
. "$HERE/lib/service/common.sh"
# shellcheck source=lib/service/macos.sh
. "$HERE/lib/service/macos.sh"
# shellcheck source=lib/service/linux.sh
. "$HERE/lib/service/linux.sh"

usage() {
  cat <<'EOF'
usage: agentx-service <command>

Commands:
  install     Install, enable, and start the user service
  uninstall   Stop and remove the generated service definition
  start       Start the installed service
  stop        Stop the installed service
  restart     Restart the installed service
  status      Show service-manager and router port status
  logs        Stream recent router logs
  update      Regenerate the definition and restart after an update or move
  help        Show this help
EOF
}

dispatch_platform() {
  local command="$1"
  case "$(os_name):$command" in
    macos:install) mac_install ;;
    macos:uninstall) mac_uninstall ;;
    macos:start) mac_start ;;
    macos:stop) mac_stop ;;
    macos:restart) mac_restart ;;
    macos:status) mac_status ;;
    macos:logs) mac_logs ;;
    macos:update) mac_update ;;
    linux:install) linux_install ;;
    linux:uninstall) linux_uninstall ;;
    linux:start) linux_start ;;
    linux:stop) linux_stop ;;
    linux:restart) linux_restart ;;
    linux:status) linux_status ;;
    linux:logs) linux_logs ;;
    linux:update) linux_update ;;
    *) die "unsupported command: $command" ;;
  esac
}

command="${1:-help}"
case "$command" in
  help|-h|--help) usage ;;
  install|uninstall|start|stop|restart|status|logs|update) dispatch_platform "$command" ;;
  *) usage; die "unknown command: $command" ;;
esac
