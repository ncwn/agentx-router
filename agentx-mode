#!/usr/bin/env node
'use strict';

const fs = require('fs');
const net = require('net');
const path = require('path');
const { ROOT, loadRoutes } = require('./src/config');

const stateFile = process.env.AGENTX_STATE_FILE || path.join(ROOT, 'var', 'active-mode');
const port = Number(process.env.AGENTX_PORT || 8787);

function currentMode() {
  try { return fs.readFileSync(stateFile, 'utf8').trim() || '(unset)'; }
  catch (_) { return '(unset)'; }
}

function printTable(headers, rows) {
  const widths = headers.map((header, index) => Math.max(header.length, ...rows.map((row) => row[index].length)));
  const line = (row) => row.map((value, index) => value.padEnd(widths[index])).join('  ').trimEnd();
  console.log(line(headers));
  console.log(line(widths.map((width) => '-'.repeat(width))));
  for (const row of rows) console.log(line(row));
}

function printModes(modes) {
  const headers = ['Mode', 'Fable', 'Opus', 'Sonnet', 'Haiku', 'Default', 'Description'];
  const rows = Object.entries(modes).map(([name, mode]) => [
    name,
    mode.routes.fable,
    mode.routes.opus,
    mode.routes.sonnet,
    mode.routes.haiku,
    mode.routes.default,
    mode.description,
  ]);

  console.log(`active mode: ${currentMode()}\n`);
  printTable(headers, rows);
  console.log('\nUpstreams are logical server groups: native, performance, balance.');
  console.log('Concrete model versions and effort settings belong to the upstream servers.');
}

function writeMode(name) {
  const directory = path.dirname(stateFile);
  fs.mkdirSync(directory, { recursive: true });
  const temporary = path.join(directory, `.${path.basename(stateFile)}.${process.pid}.${Date.now()}`);
  try {
    fs.writeFileSync(temporary, `${name}\n`, { mode: 0o600 });
    fs.renameSync(temporary, stateFile);
  } finally {
    try { fs.unlinkSync(temporary); } catch (_) {}
  }
}

function routerListening() {
  return new Promise((resolve) => {
    if (!Number.isInteger(port) || port < 1 || port > 65535) return resolve(false);
    const socket = net.connect({ host: '127.0.0.1', port });
    const done = (value) => {
      socket.destroy();
      resolve(value);
    };
    socket.setTimeout(800, () => done(false));
    socket.once('connect', () => done(true));
    socket.once('error', () => done(false));
  });
}

async function main() {
  const modes = loadRoutes();
  const argument = process.argv[2] || '';
  if (!argument || argument === '-l' || argument === '--list') {
    printModes(modes);
    return;
  }

  const mode = argument.toUpperCase();
  if (!modes[mode]) throw new Error(`unknown mode: ${mode} (run './agentx-mode --list')`);
  writeMode(mode);
  console.log(`active mode -> ${mode} (applies on the next request; no restart)`);
  if (!(await routerListening())) console.log(`note: router not detected on 127.0.0.1:${port}; start it with ./agentx-up`);
}

main().catch((error) => {
  console.error(`agentx-mode: ${error.message}`);
  process.exit(1);
});
